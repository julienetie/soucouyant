{
  // Type-checks the TypeScript versions of the browser examples. They're
  // never compiled or loaded: each page runs its .js file. Run
  // `npm run test:types` (after `npm run build`) to check them
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["browser/*.ts"]
}
