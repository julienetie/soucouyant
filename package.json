{
  "name": "soucouyant",
  "version": "0.3.0",
  "description": "Fast JavaScript state management in two weights: a small core, and temporal for undo/redo history, time travel and trajectories.",
  "keywords": [
    "state",
    "state-management",
    "store",
    "pubsub",
    "undo",
    "redo",
    "time-travel",
    "history",
    "finite-state",
    "mutex",
    "react",
    "vue",
    "angular",
    "svelte",
    "nextjs",
    "typescript",
    "timelines"
  ],
  "homepage": "https://github.com/julienetie/soucouyant#readme",
  "bugs": {
    "url": "https://github.com/julienetie/soucouyant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julienetie/soucouyant.git"
  },
  "author": {
    "name": "Julien Etienne",
    "url": "https://github.com/julienetie"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/js/soucouyant-core.js",
  "types": "./dist/ts/soucouyant-core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/soucouyant-core.d.ts",
      "default": "./dist/js/soucouyant-core.js"
    },
    "./temporal": {
      "types": "./dist/ts/soucouyant-temporal.d.ts",
      "default": "./dist/js/soucouyant-temporal.js"
    },
    "./polychrony": {
      "types": "./dist/ts/soucouyant-polychrony.d.ts",
      "default": "./dist/js/soucouyant-polychrony.js"
    },
    "./storage-sqlite": {
      "types": "./dist/ts/storage/sqlite.d.ts",
      "default": "./dist/js/storage/sqlite.js"
    },
    "./storage-indexeddb": {
      "types": "./dist/ts/storage/indexeddb.d.ts",
      "default": "./dist/js/storage/indexeddb.js"
    },
    "./bindings/react": {
      "types": "./dist/ts/bindings/react.d.ts",
      "default": "./dist/js/bindings/react.js"
    },
    "./bindings/vue": {
      "types": "./dist/ts/bindings/vue.d.ts",
      "default": "./dist/js/bindings/vue.js"
    },
    "./bindings/angular": {
      "types": "./dist/ts/bindings/angular.d.ts",
      "default": "./dist/js/bindings/angular.js"
    },
    "./bindings/svelte": {
      "types": "./dist/ts/bindings/svelte.d.ts",
      "default": "./dist/js/bindings/svelte.js"
    },
    "./bindings/next": {
      "types": "./dist/ts/bindings/next.d.ts",
      "default": "./dist/js/bindings/next.js"
    },
    "./bindings/next/client": {
      "types": "./dist/ts/bindings/next-client.d.ts",
      "default": "./dist/js/bindings/next-client.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "temporal": [
        "./dist/ts/soucouyant-temporal.d.ts"
      ],
      "polychrony": [
        "./dist/ts/soucouyant-polychrony.d.ts"
      ],
      "storage-sqlite": [
        "./dist/ts/storage/sqlite.d.ts"
      ],
      "storage-indexeddb": [
        "./dist/ts/storage/indexeddb.d.ts"
      ],
      "bindings/react": [
        "./dist/ts/bindings/react.d.ts"
      ],
      "bindings/vue": [
        "./dist/ts/bindings/vue.d.ts"
      ],
      "bindings/angular": [
        "./dist/ts/bindings/angular.d.ts"
      ],
      "bindings/svelte": [
        "./dist/ts/bindings/svelte.d.ts"
      ],
      "bindings/next": [
        "./dist/ts/bindings/next.d.ts"
      ],
      "bindings/next/client": [
        "./dist/ts/bindings/next-client.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/js/soucouyant-core.js",
    "./dist/js/soucouyant-temporal.js",
    "./dist/js/soucouyant-polychrony.js",
    "./dist/js/soucouyant-core.min.js",
    "./dist/js/soucouyant-temporal.min.js",
    "./dist/js/soucouyant-polychrony.min.js"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.js && node scripts/build-instance.js && rollup -c --silent && node scripts/format-dist.js && node scripts/build-types.js",
    "examples": "npm run build && shx cp dist/js/soucouyant-core.js dist/js/soucouyant-temporal.js dist/js/soucouyant-polychrony.js dist/js/storage/indexeddb.js examples/ && http-server examples -p 3030 -c-1",
    "size": "node scripts/size.js",
    "test": "npm run test:core && npm run test:temporal && npm run test:core-with-temporal && npm run test:polychrony",
    "test:core": "node --test \"test/core/*.test.js\"",
    "test:temporal": "node --test \"test/temporal/*.test.js\"",
    "test:core-with-temporal": "SOUCOUYANT_WITH_TEMPORAL=1 NODE_OPTIONS=\"$NODE_OPTIONS --import ./test/support/with-temporal.js\" node --test \"test/core/*.test.js\"",
    "test:polychrony": "node scripts/build-instance.js && node --test \"test/polychrony/*.test.js\"",
    "test:dist": "npm run build && SOUCOUYANT_DIST=1 NODE_OPTIONS=\"--import ./test/support/dist-loader.js\" npm test",
    "test:min": "npm run build && SOUCOUYANT_DIST=min NODE_OPTIONS=\"--import ./test/support/dist-loader.js\" npm test",
    "test:types": "node scripts/test-types.js",
    "test:natives": "node scripts/build-instance.js && node --allow-natives-syntax --expose-gc test/natives/optimization.js",
    "lint": "standard",
    "bench": "node --expose-gc bench/run.js",
    "prepublishOnly": "npm run test:dist && npm run test:min && npm run test:types"
  },
  "peerDependencies": {
    "@angular/core": ">=21",
    "next": ">=16",
    "react": ">=19",
    "svelte": ">=5.7",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^21.2.25",
    "@legendapp/state": "^2.1.15",
    "@reduxjs/toolkit": "^2.13.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/react": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "fake-indexeddb": "^6.2.7",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "mitata": "^1.0.34",
    "mobx": "^7.1.3",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.66.0",
    "rxjs": "^7.8.2",
    "shx": "^0.4.0",
    "standard": "^17.1.2",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.0.4",
    "typescript59": "npm:typescript@~5.9.3",
    "vue": "3.5",
    "xstate": "^5.33.3",
    "zustand": "^5.0.16"
  },
  "standard": {
    "ignore": [
      "archive/**",
      "test/natives/**",
      "src/polychrony/instance.generated.js",
      "examples/*.js"
    ]
  }
}
