{
  "name": "soucouyant",
  "version": "0.2.0",
  "description": "Fast JavaScript state management in two weights: a small core, and temporal for undo/redo history, time travel and trajectories.",
  "keywords": [
    "state",
    "state-management",
    "store",
    "pubsub",
    "undo",
    "redo",
    "time-travel",
    "history",
    "finite-state",
    "mutex",
    "react",
    "vue",
    "angular",
    "svelte",
    "nextjs"
  ],
  "homepage": "https://github.com/julienetie/soucouyant#readme",
  "bugs": {
    "url": "https://github.com/julienetie/soucouyant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julienetie/soucouyant.git"
  },
  "author": {
    "name": "Julien Etienne",
    "url": "https://github.com/julienetie"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/soucouyant-core.js",
  "exports": {
    ".": "./dist/soucouyant-core.js",
    "./temporal": "./dist/soucouyant-temporal.js",
    "./storage-sqlite": "./dist/storage/sqlite.js",
    "./storage-indexeddb": "./dist/storage/indexeddb.js",
    "./bindings/react": "./dist/bindings/react.js",
    "./bindings/vue": "./dist/bindings/vue.js",
    "./bindings/angular": "./dist/bindings/angular.js",
    "./bindings/svelte": "./dist/bindings/svelte.js",
    "./bindings/next": "./dist/bindings/next.js",
    "./bindings/next/client": "./dist/bindings/next-client.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/soucouyant-core.js",
    "./dist/soucouyant-temporal.js",
    "./dist/soucouyant-core.min.js",
    "./dist/soucouyant-temporal.min.js"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "rollup -c --silent && node scripts/format-dist.js",
    "size": "node scripts/size.js",
    "test": "npm run test:core && npm run test:temporal && npm run test:core-with-temporal",
    "test:core": "node --test \"test/core/*.test.js\"",
    "test:temporal": "node --test \"test/temporal/*.test.js\"",
    "test:core-with-temporal": "SOUCOUYANT_WITH_TEMPORAL=1 NODE_OPTIONS=\"$NODE_OPTIONS --import ./test/support/with-temporal.js\" node --test \"test/core/*.test.js\"",
    "test:dist": "npm run build && SOUCOUYANT_DIST=1 NODE_OPTIONS=\"--import ./test/support/dist-loader.js\" npm test",
    "test:min": "npm run build && SOUCOUYANT_DIST=min NODE_OPTIONS=\"--import ./test/support/dist-loader.js\" npm test",
    "test:natives": "node --allow-natives-syntax --expose-gc test/natives/optimization.js",
    "lint": "standard",
    "bench": "node --expose-gc bench/run.js",
    "prepublishOnly": "npm run test:dist && npm run test:min"
  },
  "peerDependencies": {
    "@angular/core": ">=21",
    "next": ">=16",
    "react": ">=19",
    "svelte": ">=5.7",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^21.2.25",
    "@legendapp/state": "^2.1.15",
    "@reduxjs/toolkit": "^2.13.0",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "mitata": "^1.0.34",
    "mobx": "^7.1.3",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.66.0",
    "rxjs": "^7.8.2",
    "standard": "^17.1.2",
    "svelte": "^5.57.3",
    "vue": "3.5",
    "xstate": "^5.33.3",
    "zustand": "^5.0.16"
  },
  "standard": {
    "ignore": [
      "archive/**",
      "test/natives/**"
    ]
  }
}
